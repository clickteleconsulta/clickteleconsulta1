node_modules/
dist/
.env
.env.local
.env.production
.vercel
.env*

# TTFs baixados por tools/gerar-marca.py (o repositório serve woff2, não TTF)
.cache-fontes/

# Lixo do Finder do macOS. Aparecia como arquivo novo a cada `git status`,
# e um deles ia junto no commit se ninguém reparasse.
.DS_Store

# Cache de rasterização das ilustrações (tools/gerar-anuncios.py).
# Reconstruído sozinho a partir dos SVGs; versionar só duplicaria peso no repo.
.cache-ilustra/

# PDFs gerados por tools/gerar-documentos-legais.py. A fonte é o .md ao lado;
# o PDF é produto, e produto de documento legal se publica por Admin -> Legal,
# nao por commit.
documentos-legais/saida/

# Texto extraido dos PDFs legais vigentes. E insumo para o juridico, nao fonte
# de verdade: a versao que vale e o PDF publicado em Admin -> Legal.
documentos-legais/*.txt

# Instancias de peso geradas de public/fonts/geist-variable.woff2 por
# tools/gerar-documentos-legais.py. Reconstruidas sozinhas; a fonte de verdade
# e o woff2 do kit da marca.
.cache-fontes/
